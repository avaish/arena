# ── Cloudflare ────────────────────────────────────────────────────────────────
# Generate at: https://dash.cloudflare.com/profile/api-tokens
# Required scopes: Workers Scripts:Edit, Pages:Edit, Workers KV Storage:Edit,
#                  D1:Edit
CLOUDFLARE_API_TOKEN=

# Found on the Workers & Pages dashboard sidebar
CLOUDFLARE_ACCOUNT_ID=

# ── CricketData.org ───────────────────────────────────────────────────────────
# Get an API key at: https://cricketdata.org
CRICKET_API_KEY=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Used for signing session cookies (HMAC-SHA256). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Pulumi Cloud ──────────────────────────────────────────────────────────────
# Generate at: https://app.pulumi.com/account/tokens
PULUMI_ACCESS_TOKEN=
