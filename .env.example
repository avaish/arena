# ── Cloudflare ────────────────────────────────────────────────────────────────
# Generate at: https://dash.cloudflare.com/profile/api-tokens
# Required scopes: Workers Scripts:Edit, Pages:Edit, Workers KV Storage:Edit,
#                  D1:Edit
CLOUDFLARE_API_TOKEN=

# Found on the Workers & Pages dashboard sidebar
CLOUDFLARE_ACCOUNT_ID=

# ── Pulumi Cloud ──────────────────────────────────────────────────────────────
# Generate at: https://app.pulumi.com/account/tokens
PULUMI_ACCESS_TOKEN=
