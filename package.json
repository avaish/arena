{
  "name": "arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\" --ignore-path .prettierignore",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "db:generate": "pnpm --filter @arena/db exec drizzle-kit generate",
    "db:migrate:local": "pnpm --filter @arena/api exec wrangler d1 migrations apply APP_DB",
    "db:migrate:dev": "bash -c 'if [ -f .env ]; then export $(grep -v \"^#\" .env | xargs); fi; pnpm --filter @arena/api exec wrangler d1 migrations apply APP_DB --env dev --remote'",
    "db:migrate:prod": "bash -c 'if [ -f .env ]; then export $(grep -v \"^#\" .env | xargs); fi; pnpm --filter @arena/api exec wrangler d1 migrations apply APP_DB --env prod --remote'"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.0",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.0.0"
  }
}
